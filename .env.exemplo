# ──────────────────────────────────────────────────────────────
#  CONFIGURAÇÃO DO ROBÔ — Polícia Civil RJ
#  Renomeie este arquivo para ".env" antes de executar o robô.
# ──────────────────────────────────────────────────────────────

# Credenciais do RASWEB (fornecidas pelo administrador)
RASWEB_USERNAME=SEU_CPF_AQUI
RASWEB_PASSWORD=SUA_SENHA_AQUI

# URL do painel de controle (fornecida pelo administrador)
API_URL=https://sua-api.railway.app
WORKER_API_KEY=CHAVE_FORNECIDA_PELO_ADMINISTRADOR

# ──────────────────────────────────────────────────────────────
#  Configurações opcionais (não alterar se não souber)
# ──────────────────────────────────────────────────────────────
RASWEB_URL=https://rasweb.pcivil.rj.gov.br/
PLAYWRIGHT_HEADLESS=false
POLLING_ASMX_MS=1000
MINUTOS_ANTECIPACAO=3
TIMEOUT_VAGAS_MS=300000

# Coloque "true" para executar mesmo fora do dia de reserva (uso em testes)
FORCAR_EXECUCAO=false
DIAGNOSTICO_MODALIDADE=presente
